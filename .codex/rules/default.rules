# ML4T Library Agent Rules
# Shared across ml4t-*-dev agents and third-edition

# ── Shell wrappers ──
# Codex wraps compound commands as /bin/bash -lc "cd ... && uv run ..."
# When scripts use env vars/redirections, Codex can't split them,
# so we allow the shell wrapper prefix.
prefix_rule(pattern=["/bin/bash", "-lc"], decision="allow",
    justification="Shell wrapper for compound commands in project sandbox")
prefix_rule(pattern=["/bin/bash", "-c"], decision="allow",
    justification="Shell wrapper for compound commands in project sandbox")
prefix_rule(pattern=["bash", "-lc"], decision="allow")
prefix_rule(pattern=["bash", "-c"], decision="allow")
prefix_rule(pattern=["cd"], decision="allow")

# ── Package management (uv) ──
prefix_rule(pattern=["uv", "run"], decision="allow")
prefix_rule(pattern=["uv", "sync"], decision="allow")
prefix_rule(pattern=["uv", "pip"], decision="allow")
prefix_rule(pattern=["uv", "build"], decision="allow")
prefix_rule(pattern=["uv", "lock"], decision="allow")
prefix_rule(pattern=["uv", "add"], decision="allow")
prefix_rule(pattern=["uv", "remove"], decision="allow")
prefix_rule(pattern=["uv", "publish"], decision="prompt",
    justification="Publishing to PyPI requires confirmation")

# ── Python execution ──
prefix_rule(pattern=["python3"], decision="allow")
prefix_rule(pattern=["python"], decision="allow")

# ── Git read operations ──
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "branch"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "stash"], decision="allow")
prefix_rule(pattern=["git", "remote"], decision="allow")
prefix_rule(pattern=["git", "rev-parse"], decision="allow")

# ── Git write operations ──
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "safe-commit"], decision="allow")
prefix_rule(pattern=["git", "checkout"], decision="allow")
prefix_rule(pattern=["git", "switch"], decision="allow")
prefix_rule(pattern=["git", "merge"], decision="allow")
prefix_rule(pattern=["git", "rm"], decision="allow")
prefix_rule(pattern=["git", "-C"], decision="allow")
prefix_rule(pattern=["git", "tag"], decision="allow")

# ── Git dangerous (prompt) ──
prefix_rule(pattern=["git", "push"], decision="prompt",
    justification="Pushing to remote requires confirmation")
prefix_rule(pattern=["git", "reset"], decision="prompt",
    justification="Reset can be destructive")
prefix_rule(pattern=["git", "rebase"], decision="prompt",
    justification="Rebase can rewrite history")

# ── GitHub CLI ──
prefix_rule(pattern=["gh", "pr"], decision="allow")
prefix_rule(pattern=["gh", "issue"], decision="allow")
prefix_rule(pattern=["gh", "run"], decision="allow")
prefix_rule(pattern=["gh", "api"], decision="allow")
prefix_rule(pattern=["gh", "release"], decision="prompt",
    justification="Releases require confirmation")

# ── Quality gates ──
prefix_rule(pattern=["pre-commit", "run"], decision="allow")
prefix_rule(pattern=["xargs", "-r", "pre-commit"], decision="allow")

# ── Safe read/inspect ──
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["find"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["wc"], decision="allow")
prefix_rule(pattern=["grep"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["tree"], decision="allow")
prefix_rule(pattern=["file"], decision="allow")
prefix_rule(pattern=["stat"], decision="allow")
prefix_rule(pattern=["du"], decision="allow")
prefix_rule(pattern=["which"], decision="allow")
prefix_rule(pattern=["echo"], decision="allow")
prefix_rule(pattern=["printf"], decision="allow")
prefix_rule(pattern=["date"], decision="allow")

# ── File operations ──
prefix_rule(pattern=["mkdir"], decision="allow")
prefix_rule(pattern=["cp"], decision="allow")
prefix_rule(pattern=["mv"], decision="allow")
prefix_rule(pattern=["touch"], decision="allow")
prefix_rule(pattern=["rm"], decision="prompt",
    justification="File deletion requires confirmation")

# ── Dev tools ──
prefix_rule(pattern=["pytest"], decision="allow")
prefix_rule(pattern=["ruff"], decision="allow")
prefix_rule(pattern=["mypy"], decision="allow")
prefix_rule(pattern=["jupytext"], decision="allow")
prefix_rule(pattern=["nvidia-smi"], decision="allow")
prefix_rule(pattern=["timeout"], decision="allow")
prefix_rule(pattern=["nohup"], decision="allow")
prefix_rule(pattern=["perl"], decision="allow")
prefix_rule(pattern=["sed"], decision="allow")
prefix_rule(pattern=["awk"], decision="allow")
prefix_rule(pattern=["sort"], decision="allow")
prefix_rule(pattern=["uniq"], decision="allow")
prefix_rule(pattern=["diff"], decision="allow")
prefix_rule(pattern=["jq"], decision="allow")
prefix_rule(pattern=["tee"], decision="allow")
prefix_rule(pattern=["sha256sum"], decision="allow")
prefix_rule(pattern=["/usr/bin/time"], decision="allow")
prefix_rule(pattern=["pgrep"], decision="allow")
prefix_rule(pattern=["pip"], decision="allow")
prefix_rule(pattern=["pip3"], decision="allow")
